{
  "manifest_version": 3,
  "name": "Dental Más Fácil - WhatsApp Leads & Citas",
  "version": "2.1.0",
  "description": "Auto-captura inteligente de nuevos leads de Meta Ads en WhatsApp Web para Dental Más Fácil. Clics seguros sin auto-registro accidental.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Dental Más Fácil - Leads & Citas"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://hzdootsarxbawbwtsfyp.supabase.co/*"
  ]
}
